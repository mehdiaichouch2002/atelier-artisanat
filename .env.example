# Copy to .env.local and fill in. Never commit real values.

# Runtime connection: the restricted `atelier_app` role (Row Level Security applies).
DATABASE_URL=postgres://atelier_app:CHANGE_ME@localhost:5432/atelier_dev

# Migrations / scripts: a role that owns the schema (e.g. `postgres`). Not used by the running app.
MIGRATION_DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/atelier_dev

# Password given to the `atelier_app` role when running `npm run db:migrate` (optional).
APP_DB_PASSWORD=CHANGE_ME

# Set to "true" only when the database requires TLS (Supabase, managed Postgres).
DATABASE_SSL=false

# Supabase transaction pooler (port 6543) does not support prepared statements: set to "false" there.
DATABASE_PREPARE=true

# Demo seed only (never in production): password for the demo owner/manager accounts.
DEMO_PASSWORD=CHANGE_ME
